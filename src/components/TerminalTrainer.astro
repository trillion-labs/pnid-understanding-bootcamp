<div class="terminal-practice" data-terminal-practice>
  <div class="practice-header">
    <div>
      <span class="status-dot" aria-hidden="true"></span>
      <strong>명령 연습 모드</strong>
    </div>
    <span class="progress" data-progress>1 / 3</span>
  </div>

  <div class="terminal-screen" data-transcript aria-live="polite">
    <p class="system-line">실제 모델을 호출하지 않는 안전한 연습 화면입니다.</p>
  </div>

  <form class="command-form" data-command-form>
    <label for="workbook-command">현재 단계: <span data-instruction>프로젝트 폴더로 이동하세요.</span></label>
    <div class="input-row">
      <span class="prompt" aria-hidden="true">$</span>
      <input
        id="workbook-command"
        data-command-input
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-describedby="command-feedback command-hint"
        placeholder="명령을 직접 입력하고 Enter를 누르세요"
      />
    </div>
    <p id="command-feedback" class="feedback" data-feedback>명령을 입력하면 이곳에 결과가 표시됩니다.</p>
    <p id="command-hint" class="hint" data-hint>힌트: 폴더 이동 명령은 <code>cd</code>로 시작합니다.</p>
    <div class="actions">
      <button type="button" class="secondary" data-show-answer>명령 힌트 보기</button>
      <button type="button" class="secondary" data-reset>처음부터</button>
    </div>
  </form>
</div>

<script>
  const tasks = [
    {
      command: 'cd ~/Projects/pnid-understanding-bootcamp',
      instruction: '프로젝트 폴더로 이동하세요.',
      hint: '폴더 이동 명령은 cd로 시작합니다.',
      output: '/Users/learner/Projects/pnid-understanding-bootcamp',
    },
    {
      command: './scripts/run-workbook-cli.sh claude full',
      instruction: 'Claude Sonnet에 전체 이미지를 전달하세요.',
      hint: '실행 스크립트 뒤에 claude와 full을 차례로 적습니다.',
      output: 'Claude Sonnet · 전체 이미지 · 결과 저장 완료',
    },
    {
      command: './scripts/run-workbook-cli.sh codex-luna zoom',
      instruction: 'Codex Luna에 부분 확대 이미지를 전달하세요.',
      hint: '실행 스크립트 뒤에 codex-luna와 zoom을 차례로 적습니다.',
      output: 'Codex Luna · 부분 확대 이미지 · 결과 저장 완료',
    },
  ];

  const normalize = (value: string) => value.trim().replace(/\s+/g, ' ');

  document.querySelectorAll<HTMLElement>('[data-terminal-practice]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-command-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-command-input]')!;
    const transcript = root.querySelector<HTMLElement>('[data-transcript]')!;
    const feedback = root.querySelector<HTMLElement>('[data-feedback]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const instruction = root.querySelector<HTMLElement>('[data-instruction]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const showAnswer = root.querySelector<HTMLButtonElement>('[data-show-answer]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    let current = 0;

    const addLine = (className: string, value: string) => {
      const line = document.createElement('p');
      line.className = className;
      line.textContent = value;
      transcript.appendChild(line);
      transcript.scrollTop = transcript.scrollHeight;
    };

    const renderTask = () => {
      const task = tasks[current];
      progress.textContent = `${Math.min(current + 1, tasks.length)} / ${tasks.length}`;
      instruction.textContent = task.instruction;
      hint.textContent = `힌트: ${task.hint}`;
      input.value = '';
      input.disabled = false;
      input.focus();
    };

    const resetPractice = () => {
      current = 0;
      transcript.replaceChildren();
      addLine('system-line', '실제 모델을 호출하지 않는 안전한 연습 화면입니다.');
      feedback.textContent = '명령을 입력하면 이곳에 결과가 표시됩니다.';
      feedback.dataset.state = 'idle';
      showAnswer.disabled = false;
      renderTask();
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const task = tasks[current];
      const typed = normalize(input.value);

      if (typed !== normalize(task.command)) {
        feedback.textContent = '아직 명령이 일치하지 않습니다. 띄어쓰기와 철자를 다시 확인해 주세요.';
        feedback.dataset.state = 'error';
        return;
      }

      addLine('command-line', `$ ${typed}`);
      addLine('output-line', task.output);
      feedback.textContent = '정확합니다. 다음 단계로 이동합니다.';
      feedback.dataset.state = 'success';
      current += 1;

      if (current === tasks.length) {
        progress.textContent = `${tasks.length} / ${tasks.length}`;
        instruction.textContent = '세 단계를 모두 완료했습니다.';
        hint.textContent = '이제 실제 터미널에서 같은 명령을 실행해 보세요.';
        feedback.textContent = '완료했습니다. Claude와 Codex 실행 명령을 직접 입력할 수 있습니다.';
        input.value = '';
        input.disabled = true;
        showAnswer.disabled = true;
        return;
      }

      renderTask();
    });

    showAnswer.addEventListener('click', () => {
      input.value = tasks[current].command;
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
      feedback.textContent = '명령을 확인했습니다. 직접 Enter를 눌러 실행해 보세요.';
      feedback.dataset.state = 'idle';
    });

    reset.addEventListener('click', resetPractice);
  });
</script>

<style>
  .terminal-practice {
    overflow: hidden;
    margin-block: 1.5rem 2rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-4) 45%, transparent);
    border-radius: 0.9rem;
    background: #0c1424;
    box-shadow: 0 18px 45px rgb(5 12 25 / 18%);
    color: #e7edf6;
  }

  .practice-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    background: #141f33;
    font-size: 0.86rem;
  }

  .practice-header > div {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .status-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: #6ee7d8;
    box-shadow: 0 0 0 4px rgb(110 231 216 / 12%);
  }

  .progress {
    color: #9eacc2;
    font-variant-numeric: tabular-nums;
  }

  .terminal-screen {
    min-height: 10rem;
    max-height: 18rem;
    overflow-y: auto;
    padding: 1rem;
    font-family: var(--sl-font-system-mono);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .terminal-screen :global(p) {
    margin: 0 0 0.35rem;
  }

  .terminal-screen :global(.system-line) {
    color: #91a0b8;
  }

  .terminal-screen :global(.command-line) {
    color: #f4f7fb;
  }

  .terminal-screen :global(.output-line) {
    color: #6ee7d8;
  }

  .command-form {
    padding: 1rem;
    border-top: 1px solid rgb(255 255 255 / 10%);
    background: #111b2d;
  }

  .command-form label {
    display: block;
    margin-bottom: 0.6rem;
    color: #c7d2e3;
    font-size: 0.9rem;
  }

  .input-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.68rem 0.8rem;
    border: 1px solid #394760;
    border-radius: 0.55rem;
    background: #080f1c;
  }

  .input-row:focus-within {
    border-color: #6ee7d8;
    box-shadow: 0 0 0 3px rgb(110 231 216 / 12%);
  }

  .prompt {
    color: #6ee7d8;
    font-family: var(--sl-font-system-mono);
    font-weight: 700;
  }

  input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: #f4f7fb;
    font-family: var(--sl-font-system-mono);
    font-size: 0.9rem;
  }

  input::placeholder {
    color: #6f7e96;
  }

  input:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .feedback,
  .hint {
    margin: 0.65rem 0 0;
    font-size: 0.84rem;
  }

  .feedback {
    color: #9eacc2;
  }

  .feedback[data-state='success'] {
    color: #6ee7d8;
  }

  .feedback[data-state='error'] {
    color: #ff9a9a;
  }

  .hint {
    color: #9eacc2;
  }

  .hint :global(code) {
    color: #ffcf8a;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.85rem;
  }

  button.secondary {
    border: 1px solid #465673;
    border-radius: 999px;
    padding: 0.5rem 0.8rem;
    background: transparent;
    color: #dbe5f2;
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }

  button.secondary:hover:not(:disabled) {
    border-color: #6ee7d8;
    color: #ffffff;
  }

  button.secondary:focus-visible {
    outline: 2px solid #6ee7d8;
    outline-offset: 2px;
  }

  button.secondary:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  @media (max-width: 40rem) {
    .terminal-screen {
      min-height: 8rem;
    }

    input {
      font-size: 0.82rem;
    }
  }
</style>
